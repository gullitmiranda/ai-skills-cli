#!/usr/bin/env bash
set -euo pipefail

readonly VERSION="0.2.0"
readonly STATE_DIR="${AI_SKILLS_HOME:-$HOME/.ai-skills}"
readonly MANIFEST="$STATE_DIR/manifest.json"
readonly CONFIG_FILE="$STATE_DIR/config.json"
readonly PROFILE_SPECS_DIR="${STATE_DIR}/profiles"
readonly PROFILE_FRAGMENTS_DIR="${STATE_DIR}/profiles.d"
readonly NPX_SKILLS_PACKAGE="${AI_SKILLS_NPX_PACKAGE:-skills}"

_resolve_source() {
	local src="${BASH_SOURCE[0]}"
	while [[ -L $src ]]; do
		local dir="$(cd "$(dirname "$src")" && pwd)"
		src="$(readlink "$src")"
		[[ $src != /* ]] && src="$dir/$src"
	done
	echo "$src"
}

SCRIPT_DIR="$(cd "$(dirname "$(_resolve_source)")" && pwd)"
REPO_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"

# --- Agent adapter config ---

declare -A AGENT_DIRS=(
	[agents]="${HOME}/.agents/skills"
	[cursor]="$HOME/.cursor/skills"
	[claude]="$HOME/.claude/skills"
	[codex]="$HOME/.codex/skills"
	[factory]="$HOME/.factory/skills"
	[copilot]="$HOME/.github/skills"
)

# Back-compat: legacy agent names that map to canonical entries above.
# Allows manifests and CLI flags using the old name to keep working.
declare -A AGENT_ALIASES=(
	["pi-mono"]="agents"
)

readonly SUPPORTED_AGENTS=("agents" "cursor" "claude" "codex" "factory" "copilot")
readonly DEFAULT_AGENTS=("agents" "cursor" "claude" "factory")

# --- Colors / output ---

_red() { printf '\033[0;31m%s\033[0m' "$*"; }
_green() { printf '\033[0;32m%s\033[0m' "$*"; }
_yellow() { printf '\033[0;33m%s\033[0m' "$*"; }
_bold() { printf '\033[1m%s\033[0m' "$*"; }
_dim() { printf '\033[2m%s\033[0m' "$*"; }

info() { echo "  $(_green "✓") $*"; }
warn() { echo "  $(_yellow "⚠") $*" >&2; }
err() { echo "  $(_red "✗") $*" >&2; }
debug() { [[ ${AI_SKILLS_DEBUG-} == "1" ]] && echo "  $(_dim "[debug]") $*" >&2 || true; }

die() {
	err "$@"
	exit 1
}

# --- Flags (global) ---

DRY_RUN=false
TARGET_AGENT=""
FLAG_REF=""
FLAG_PATH=""
FLAG_PROFILE=""
BACKEND="${AI_SKILLS_BACKEND:-legacy}"
LEGACY_SKILL_FILTERS_CSV=""

# --- Helpers ---

require_cmd() {
	command -v "$1" &>/dev/null || die "Required command not found: $1"
}

ensure_state_dir() {
	mkdir -p "$STATE_DIR"
	[[ -f $MANIFEST ]] || write_manifest '{"version":1,"agents":[],"skills":{}}'
	[[ -f $CONFIG_FILE ]] || echo '{"default_profile":"personal","profiles":{"personal":{}}}' | jq . >"$CONFIG_FILE"
}

validate_backend() {
	case "$1" in
	legacy | npx-skills) ;;
	*) die "Unknown backend: $1 (expected: legacy or npx-skills)" ;;
	esac
}

set_backend() {
	validate_backend "$1"
	BACKEND="$1"
}

# --- Config / Profiles ---

read_config() {
	cat "$CONFIG_FILE"
}

write_config() {
	echo "$1" | jq . >"$CONFIG_FILE"
}

config_get() {
	jq -r "$1" "$CONFIG_FILE" 2>/dev/null
}

get_default_profile() {
	config_get '.default_profile // "personal"'
}

resolve_profile() {
	local name="${FLAG_PROFILE:-$(get_default_profile)}"
	resolve_profile_name "${name}"
}

resolve_profile_name() {
	local name="$1"
	local exists
	exists="$(config_get ".profiles[\"$name\"] // empty")"
	[[ -z $exists ]] && die "Profile not found: $name (run 'ai-skills profile list')"
	echo "$name"
}

repos_dir_for_profile() {
	local profile="$1"
	local custom_dir
	custom_dir="$(config_get ".profiles[\"$profile\"].repos_dir // empty")"
	if [[ -n $custom_dir ]]; then
		eval echo "$custom_dir"
	else
		echo "$STATE_DIR/repos/$profile"
	fi
}

current_repos_dir() {
	local profile
	profile="$(resolve_profile)"
	repos_dir_for_resolved_profile "${profile}"
}

repos_dir_for_resolved_profile() {
	local profile="$1"
	local dir
	dir="$(repos_dir_for_profile "$profile")"
	mkdir -p "$dir"
	echo "$dir"
}

resolve_existing_file() {
	local input="$1"
	input="${input/#\~/${HOME}}"
	[[ -f ${input} ]] || die "File not found: ${input}"
	local dir base
	dir="$(cd "$(dirname "${input}")" && pwd)"
	base="$(basename "${input}")"
	echo "${dir}/${base}"
}

profile_spec_path() {
	local profile="$1"
	echo "${PROFILE_SPECS_DIR}/${profile}.yaml"
}

profile_fragments_dir() {
	local profile="$1"
	echo "${PROFILE_FRAGMENTS_DIR}/${profile}"
}

read_manifest() {
	cat "$MANIFEST"
}

write_manifest() {
	local content="$1"
	echo "$content" | jq '.' >"$MANIFEST.tmp" && mv "$MANIFEST.tmp" "$MANIFEST"
}

manifest_get() {
	jq -r "$1" "$MANIFEST"
}

manifest_set() {
	local filter="$1"
	local tmp
	tmp="$(jq "$filter" "$MANIFEST")"
	write_manifest "$tmp"
}

manifest_skill_ids_for_source() {
	local source="$1"
	jq -r --arg source "${source}" '.skills | to_entries[] | select(.value.source == $source) | .key' "${MANIFEST}"
}

manifest_skill_ids_for_repo() {
	local repo_source="$1"
	local repo_id="${repo_source#github.com/}"
	jq -r --arg source "${repo_source}" --arg prefix "${repo_id}/" \
		'.skills | to_entries[] | select(.value.source == $source or (.key | startswith($prefix))) | .key' "${MANIFEST}"
}

now_iso() {
	date -u +"%Y-%m-%dT%H:%M:%SZ"
}

configured_agents() {
	local agents
	agents="$(manifest_get '.agents // [] | .[]' 2>/dev/null)" || true
	if [[ -z $agents ]]; then
		printf '%s\n' "${DEFAULT_AGENTS[@]}"
		return
	fi
	# Normalize legacy/aliased names (e.g. pi-mono -> agents) and dedupe.
	declare -A seen
	while IFS= read -r a; do
		[[ -z ${a} ]] && continue
		a="$(resolve_agent "${a}")"
		[[ -n ${seen[${a}]-} ]] && continue
		seen[${a}]=1
		echo "${a}"
	done <<<"${agents}"
}

target_agents() {
	if [[ -n $TARGET_AGENT ]]; then
		echo "$TARGET_AGENT"
	else
		configured_agents
	fi
}

# Resolve a possibly-aliased agent name to its canonical key.
resolve_agent() {
	local agent="$1"
	local canonical="${AGENT_ALIASES[${agent}]-}"
	if [[ -n ${canonical} ]]; then
		echo "${canonical}"
	else
		echo "${agent}"
	fi
}

agent_dir() {
	local agent
	agent="$(resolve_agent "$1")"
	echo "${AGENT_DIRS[$agent]-}"
}

npx_skills_agent() {
	local agent
	agent="$(resolve_agent "$1")"
	case "${agent}" in
	agents) echo "universal" ;;
	claude) echo "claude-code" ;;
	cursor | codex | factory | copilot) echo "${agent}" ;;
	*) echo "${agent}" ;;
	esac
}

npx_skills_agent_display() {
	local agent
	agent="$(resolve_agent "$1")"
	case "${agent}" in
	agents) echo "Universal" ;;
	claude | claude-code) echo "Claude Code" ;;
	cursor) echo "Cursor" ;;
	codex) echo "Codex" ;;
	factory | droid) echo "Droid" ;;
	copilot | github-copilot) echo "GitHub Copilot" ;;
	*) echo "${agent}" ;;
	esac
}

print_command() {
	printf '    '
	printf '%q ' "$@"
	printf '\n'
}

run_or_preview() {
	if ${DRY_RUN}; then
		info "[dry-run] Would run:"
		print_command "$@"
	else
		"$@"
	fi
}

source_for_npx_skills_backend() {
	local source="$1"

	if [[ -n ${FLAG_PATH} ]]; then
		case "${source}" in
		/* | ~* | ./* | ../* | . | ..)
			echo "${source%/}/${FLAG_PATH}"
			return
			;;
		*) ;;
		esac
		local parsed owner repo ref path
		parsed="$(parse_github_source "${source}")"
		IFS='|' read -r owner repo ref path <<<"${parsed}"
		echo "https://github.com/${owner}/${repo}/tree/${ref}/${path}"
		return
	fi

	if [[ -n ${FLAG_REF} ]]; then
		case "${source}" in
		/* | ~* | ./* | ../* | . | ..) ;;
		*)
			echo "${source}@${FLAG_REF}"
			return
			;;
		esac
	fi

	echo "${source}"
}

npx_skills_verify_install() {
	local agents_csv="$1"
	shift
	local skill_filters=("$@")

	${DRY_RUN} && return
	[[ ${#skill_filters[@]} -eq 0 ]] && return

	local named_skills=()
	local skill
	for skill in "${skill_filters[@]}"; do
		[[ -z ${skill} || ${skill} == "*" ]] && continue
		named_skills+=("${skill}")
	done
	[[ ${#named_skills[@]} -eq 0 ]] && return

	local agents=()
	if [[ -n ${agents_csv} ]]; then
		IFS=',' read -r -a agents <<<"${agents_csv}"
	else
		# shellcheck disable=SC2312
		mapfile -t agents < <(target_agents)
	fi

	local list_json
	if ! list_json="$(npx --yes "${NPX_SKILLS_PACKAGE}" list -g --json 2>/dev/null)"; then
		warn "Could not verify npx-skills install with 'npx skills list -g --json'"
		return
	fi

	for skill in "${named_skills[@]}"; do
		local expected_agent observed_agents agent
		for agent in "${agents[@]}"; do
			[[ -z ${agent} ]] && continue
			expected_agent="$(npx_skills_agent_display "${agent}")"
			if ! jq -e --arg skill "${skill}" --arg agent "${expected_agent}" \
				'any(.[]; .name == $skill and ((.agents // []) | index($agent)))' <<<"${list_json}" >/dev/null; then
				observed_agents="$(jq -r --arg skill "${skill}" \
					'[.[] | select(.name == $skill) | (.agents // [])[]] | unique | join(", ")' <<<"${list_json}")"
				[[ -z ${observed_agents} ]] && observed_agents="not listed"
				warn "npx-skills installed '${skill}', but global list does not show agent '${expected_agent}' (observed: ${observed_agents})"
			fi
		done
	done
}

npx_skills_apply_cursor_global_workaround() {
	local agents_csv="$1"
	shift
	local skill_filters=("$@")

	${DRY_RUN} && return
	[[ ${#skill_filters[@]} -eq 0 ]] && return

	local agents=()
	if [[ -n ${agents_csv} ]]; then
		IFS=',' read -r -a agents <<<"${agents_csv}"
	else
		# shellcheck disable=SC2312
		mapfile -t agents < <(target_agents)
	fi

	local wants_cursor=false agent
	for agent in "${agents[@]}"; do
		local resolved_agent
		resolved_agent="$(resolve_agent "${agent}")"
		[[ ${resolved_agent} == "cursor" ]] && wants_cursor=true
	done
	${wants_cursor} || return

	# TODO/FIXME: remove this workaround once npx skills reliably links global
	# Cursor installs into ~/.cursor/skills and defaults to symlink mode.
	# Upstream tracking:
	# - https://github.com/vercel-labs/skills/issues/421
	# - https://github.com/vercel-labs/skills/issues/537
	# - https://github.com/vercel-labs/skills/issues/745
	# - https://github.com/vercel-labs/skills/pull/694
	# - https://github.com/vercel-labs/skills/pull/799
	local skill
	for skill in "${skill_filters[@]}"; do
		[[ -z ${skill} || ${skill} == "*" ]] && continue
		local canonical="${HOME}/.agents/skills/${skill}"
		local cursor_target="${HOME}/.cursor/skills/${skill}"
		[[ -d ${canonical} ]] || continue

		mkdir -p "${HOME}/.cursor/skills"
		if [[ -L ${cursor_target} ]]; then
			local existing
			existing="$(readlink "${cursor_target}")"
			[[ ${existing} == "${canonical}" ]] && continue
			warn "Cursor skill link exists with unexpected target: ${cursor_target} -> ${existing}"
			continue
		fi
		if [[ -e ${cursor_target} ]]; then
			warn "Cursor skill already exists and is not a symlink: ${cursor_target}"
			continue
		fi
		ln -s "${canonical}" "${cursor_target}"
		info "Linked Cursor global skill workaround: ${cursor_target} -> ${canonical}"
	done
}

npx_skills_add() {
	local source="$1"
	shift
	npx_skills_add_for_agents "${source}" "" "$@"
}

npx_skills_add_for_agents() {
	local source="$1" agents_csv="$2"
	shift 2
	local skill_filters=("$@")
	local npx_skills_source
	npx_skills_source="$(source_for_npx_skills_backend "${source}")"

	local cmd=(npx --yes "${NPX_SKILLS_PACKAGE}" add "${npx_skills_source}" -g -y)
	local agents
	if [[ -n ${agents_csv} ]]; then
		IFS=',' read -r -a agents <<<"${agents_csv}"
	else
		# shellcheck disable=SC2312
		mapfile -t agents < <(target_agents)
	fi
	for agent in "${agents[@]}"; do
		[[ -z ${agent} ]] && continue
		local npx_agent
		npx_agent="$(npx_skills_agent "${agent}")"
		cmd+=(--agent "${npx_agent}")
	done

	if [[ ${#skill_filters[@]} -eq 0 ]]; then
		if [[ -z ${FLAG_PATH} && ${source} != *"/tree/"* ]]; then
			cmd+=(--skill "*")
		fi
	else
		local skill
		for skill in "${skill_filters[@]}"; do
			[[ -z ${skill} ]] && continue
			cmd+=(--skill "${skill}")
		done
	fi

	run_or_preview "${cmd[@]}"
	npx_skills_apply_cursor_global_workaround "${agents_csv}" "${skill_filters[@]}"
	npx_skills_verify_install "${agents_csv}" "${skill_filters[@]}"
}

npx_skills_update() {
	local target="${1-}"
	local cmd=(npx --yes "${NPX_SKILLS_PACKAGE}" update)
	[[ -n ${target} ]] && cmd+=("${target}")
	run_or_preview "${cmd[@]}"
}

npx_skills_list() {
	run_or_preview npx --yes "${NPX_SKILLS_PACKAGE}" list
}

npx_skills_remove() {
	local target="$1"
	run_or_preview npx --yes "${NPX_SKILLS_PACKAGE}" remove "${target}"
}

npx_skills_check() {
	if ! command -v npx &>/dev/null; then
		warn "npx: not installed (required for backend=npx-skills)"
		return 1
	fi
	npx --yes "${NPX_SKILLS_PACKAGE}" check
}

# --- GitHub URL parsing ---

parse_github_source() {
	local input="$1"
	local owner="" repo="" ref="" path=""

	input="${input%.git}"
	input="${input%/}"

	if [[ $input =~ ^https?://github\.com/([^/]+)/([^/]+)(/tree/([^/]+)(/(.+))?)?$ ]]; then
		owner="${BASH_REMATCH[1]}"
		repo="${BASH_REMATCH[2]}"
		ref="${BASH_REMATCH[4]-}"
		path="${BASH_REMATCH[6]-}"
	elif [[ $input =~ ^github\.com/([^/]+)/([^/]+)(/(.+))?$ ]]; then
		owner="${BASH_REMATCH[1]}"
		repo="${BASH_REMATCH[2]}"
		path="${BASH_REMATCH[4]-}"
	elif [[ $input =~ ^([^/]+)/([^/]+)(/(.+))?$ ]]; then
		owner="${BASH_REMATCH[1]}"
		repo="${BASH_REMATCH[2]}"
		path="${BASH_REMATCH[4]-}"
	else
		die "Cannot parse source: $input"
	fi

	[[ -n $FLAG_REF ]] && ref="$FLAG_REF"
	[[ -n $FLAG_PATH ]] && path="$FLAG_PATH"
	[[ -z $ref ]] && ref="main"

	echo "$owner|$repo|$ref|$path"
}

github_repo_selector_source() {
	local input="$1"
	local owner="" repo=""

	input="${input%.git}"
	input="${input%/}"

	if [[ ${input} =~ ^https?://github\.com/([^/]+)/([^/]+)$ ]]; then
		owner="${BASH_REMATCH[1]}"
		repo="${BASH_REMATCH[2]}"
	elif [[ ${input} =~ ^github\.com/([^/]+)/([^/]+)$ ]]; then
		owner="${BASH_REMATCH[1]}"
		repo="${BASH_REMATCH[2]}"
	elif [[ ${input} =~ ^([^/]+)/([^/]+)$ ]]; then
		owner="${BASH_REMATCH[1]}"
		repo="${BASH_REMATCH[2]}"
	else
		echo ""
		return 0
	fi

	echo "github.com/${owner}/${repo}"
}

is_local_path() {
	local input="$1"
	[[ ${input} == local:* || $input == /* || $input == ~* || $input == ./* || $input == ../* || $input == . || $input == .. ]]
}

resolve_local_repo() {
	local input="$1"
	input="${input#local:}"
	input="${input/#\~/$HOME}"
	local abs_path
	abs_path="$(cd "$input" 2>/dev/null && pwd)" || die "Directory not found: $input"

	[[ -d "$abs_path/.git" ]] || die "Not a git repository: $abs_path"

	local remote_url owner="" repo=""
	remote_url="$(git -C "$abs_path" remote get-url origin 2>/dev/null || true)"

	if [[ -n $remote_url ]]; then
		remote_url="${remote_url%.git}"
		if [[ $remote_url =~ github\.com[:/]([^/]+)/([^/]+)$ ]]; then
			owner="${BASH_REMATCH[1]}"
			repo="${BASH_REMATCH[2]}"
		fi
	fi

	if [[ -z $owner || -z $repo ]]; then
		repo="$(basename "$abs_path")"
		owner="$(basename "$(dirname "$abs_path")")"
	fi

	echo "$abs_path|$owner|$repo"
}

source_id() {
	local owner="$1" repo="$2" path="$3"
	if [[ -n $path ]]; then
		echo "${owner}/${repo}/${path}"
	else
		echo "${owner}/${repo}"
	fi
}

source_type_for_manifest_source() {
	local source="$1"
	case "${source}" in
	local:*) echo "local-worktree" ;;
	github.com/*) echo "remote-git" ;;
	"") echo "unknown" ;;
	*) echo "unknown" ;;
	esac
}

canonical_local_source_key() {
	local source="$1"
	source="${source#local:}"
	source="${source/#\~/${HOME}}"
	if [[ -d ${source} ]]; then
		source="$(cd "${source}" && pwd -P)"
	fi
	printf "local:%s\n" "${source}"
}

source_key() {
	local source="$1"
	case "${source}" in
	local:* | /* | ~* | ./* | ../* | . | ..)
		canonical_local_source_key "${source}"
		return
		;;
	*) ;;
	esac
	source="${source#https://github.com/}"
	source="${source#http://github.com/}"
	source="${source#github.com/}"
	source="${source%.git}"
	echo "${source}"
}

install_mode_for_source_type() {
	local source_type="$1"
	case "${source_type}" in
	local-worktree) echo "direct-link" ;;
	remote-git | local-cache) echo "cached-link" ;;
	*) echo "unknown" ;;
	esac
}

# --- Git operations ---

find_repo_in_other_profiles() {
	local owner="$1" repo="$2" current_profile="$3"
	local profiles
	profiles="$(config_get '.profiles | keys[]')"
	while IFS= read -r profile; do
		[[ $profile == "$current_profile" ]] && continue
		local dir
		dir="$(repos_dir_for_profile "$profile")"
		if [[ -d "$dir/$owner/$repo/.git" ]]; then
			echo "$profile|$dir/$owner/$repo"
			return 0
		fi
	done <<<"$profiles"
	return 1
}

migrate_repo_between_profiles() {
	local owner="$1" repo="$2" old_dir="$3" new_dir="$4"
	mkdir -p "$(dirname "$new_dir")"
	mv "$old_dir" "$new_dir"
	info "Migrated $owner/$repo to current profile"

	# Clean up empty parent dirs
	local old_parent
	old_parent="$(dirname "$old_dir")"
	rmdir "$old_parent" 2>/dev/null || true
}

clone_or_update_repo() {
	local owner="$1" repo="$2" ref="$3"
	local profile="${4:-$(resolve_profile)}"
	profile="$(resolve_profile_name "${profile}")"
	local repos_base
	repos_base="$(repos_dir_for_resolved_profile "${profile}")"
	local repo_dir="$repos_base/$owner/$repo"

	if [[ ! -d "$repo_dir/.git" ]]; then
		local other_match
		if other_match="$(find_repo_in_other_profiles "$owner" "$repo" "${profile}")"; then
			local other_profile other_dir
			IFS='|' read -r other_profile other_dir <<<"$other_match"
			warn "$owner/$repo found in profile \"$other_profile\" instead of \"${profile}\""
			if [[ -t 0 ]]; then
				printf "  Move to current profile? [y/N] " >&2
				read -r answer </dev/tty
				if [[ $answer =~ ^[Yy]$ ]]; then
					migrate_repo_between_profiles "$owner" "$repo" "$other_dir" "$repo_dir"
				else
					warn "Keeping in \"$other_profile\". Symlinks will point to that profile."
					repo_dir="$other_dir"
				fi
			else
				warn "Non-interactive: leaving existing clone in \"$other_profile\" and using profile \"${profile}\""
			fi
		fi
	fi

	if ${DRY_RUN} && [[ ! -d "${repo_dir}/.git" ]]; then
		debug "Dry-run: skipping clone for ${owner}/${repo}"
		echo "${repo_dir}"
		return
	fi

	if [[ -d "$repo_dir/.git" ]]; then
		debug "Updating repo $owner/$repo"
		git -C "$repo_dir" fetch --depth 1 origin "$ref" 2>/dev/null ||
			git -C "$repo_dir" fetch origin 2>/dev/null ||
			warn "Failed to fetch updates for $owner/$repo"
		git -C "$repo_dir" checkout "$ref" -- &>/dev/null ||
			git -C "$repo_dir" checkout "origin/$ref" -- &>/dev/null || true
		git -C "$repo_dir" reset --hard "origin/$ref" &>/dev/null ||
			git -C "$repo_dir" reset --hard "$ref" &>/dev/null || true
	else
		debug "Cloning $owner/$repo (ref=$ref)"
		mkdir -p "$repo_dir"
		if ! git clone --depth 1 --branch "${ref}" \
			"https://github.com/${owner}/${repo}.git" "${repo_dir}" 2>/dev/null &&
			! git clone --depth 1 \
				"https://github.com/${owner}/${repo}.git" "${repo_dir}" 2>/dev/null; then
			rm -rf "${repo_dir}"
			rmdir "$(dirname "${repo_dir}")" 2>/dev/null || true
			die "Failed to clone ${owner}/${repo}"
		fi
		if [[ -n $ref && $ref != "main" && $ref != "master" ]]; then
			git -C "$repo_dir" checkout "$ref" 2>/dev/null || true
		fi
	fi

	echo "$repo_dir"
}

# --- Skill discovery ---

_find_skill_dirs() {
	local base="$1"
	[[ -d $base ]] || return
	while IFS= read -r skill_md; do
		dirname "$skill_md"
	done < <(find "$base" -name SKILL.md -type f 2>/dev/null)
}

discover_skills() {
	local repo_dir="$1"
	local subpath="$2"
	local agent="$3"
	local skills=()

	if [[ -n $subpath ]]; then
		local full_path="$repo_dir/$subpath"
		if [[ -d $full_path ]]; then
			mapfile -t -O "${#skills[@]}" skills < <(_find_skill_dirs "$full_path")
			[[ ${#skills[@]} -eq 0 ]] && skills+=("$full_path")
		elif [[ -f $full_path ]]; then
			skills+=("$(dirname "$full_path")")
		else
			die "Path not found in repo: $subpath"
		fi
		printf '%s\n' "${skills[@]}"
		return
	fi

	# Agent-specific skills
	mapfile -t -O "${#skills[@]}" skills < <(_find_skill_dirs "$repo_dir/.${agent}/skills")

	# Common locations
	for prefix in ".agents/skills" "skills"; do
		mapfile -t -O "${#skills[@]}" skills < <(_find_skill_dirs "$repo_dir/$prefix")
	done

	# Single SKILL.md at root
	if [[ ${#skills[@]} -eq 0 && -f "$repo_dir/SKILL.md" ]]; then
		skills+=("$repo_dir")
	fi

	if [[ ${#skills[@]} -eq 0 ]]; then
		warn "No skills discovered in repo"
		return
	fi

	printf '%s\n' "${skills[@]}"
}

filter_skill_dirs_by_name() {
	local filters_csv="$1"
	shift

	if [[ -z ${filters_csv} || ${filters_csv} == "*" ]]; then
		printf '%s\n' "$@"
		return
	fi

	local filters=()
	IFS=',' read -r -a filters <<<"${filters_csv}"

	local skill_dir filter matched
	for skill_dir in "$@"; do
		[[ -z ${skill_dir} ]] && continue
		local skill_name
		skill_name="$(basename "${skill_dir}")"
		matched=false
		for filter in "${filters[@]}"; do
			[[ -z ${filter} || ${filter} == "*" ]] && continue
			if [[ ${skill_name} == "${filter}" ]]; then
				matched=true
				break
			fi
		done
		${matched} && printf '%s\n' "${skill_dir}"
	done
}

# --- Skill installation ---

install_skill_to_agent() {
	local skill_dir="$1"
	local agent="$2"
	local sid="$3"

	local dest
	dest="$(agent_dir "$agent")"
	[[ -z $dest ]] && {
		warn "Unknown agent: $agent"
		return
	}

	skill_dir="${skill_dir%/}"
	local skill_name
	skill_name="$(basename "$skill_dir")"

	local target="$dest/$skill_name"

	if $DRY_RUN; then
		info "[dry-run] Would install $skill_name -> $target"
		return
	fi

	mkdir -p "$dest"
	if [[ -L $target ]]; then
		rm -f "$target"
	elif [[ -d $target ]]; then
		warn "$skill_name already exists as a real directory in $agent (not a symlink): $target"
		warn "Skipping. Remove it manually first if you want ai-skills to manage it."
		return
	fi
	ln -s "$skill_dir" "$target"
	info "Installed $(_bold "$skill_name") -> $agent (symlink)"
}

update_manifest_skill() {
	local sid="$1" source_str="$2" path="$3" ref="$4"
	shift 4
	local agents_json="[]"
	local source_type profile_json="null"

	for a in "$@"; do
		agents_json="$(echo "$agents_json" | jq --arg a "$a" '. + [$a]')"
	done

	local now
	now="$(now_iso)"
	local existing_installed
	existing_installed="$(manifest_get ".skills[\"$sid\"].installed_at // \"$now\"")"
	source_type="$(source_type_for_manifest_source "${source_str}")"
	if [[ ${source_type} == "remote-git" ]]; then
		local profile
		profile="$(resolve_profile)"
		profile_json="$(jq -n --arg profile "${profile}" '$profile')"
	fi

	manifest_set "
    .skills[\"$sid\"] = ({
      \"source\": \"$source_str\",
      \"path\": \"$path\",
      \"ref\": \"$ref\",
      \"agents\": $agents_json,
      \"installed_at\": \"$existing_installed\",
      \"updated_at\": \"$now\"
    } + (if ${profile_json} == null then {} else {\"profile\": ${profile_json}} end))
  "
}

# --- Declarative sync ---

spec_rows() {
	local spec_file="$1"
	yq -o=json '.' "${spec_file}" | jq -r --arg backend "${BACKEND}" '
		(.defaults // {}) as $defaults
		| (.skills // [])[]
		| (.source // empty) as $source
		| select($source != "")
		| (.skills // .skill // ["*"]) as $skill_filter
		| [
			$source,
			(.ref // $defaults.ref // ""),
			(.backend // $defaults.backend // $backend),
			(.scope // $defaults.scope // "global"),
			((.agents // $defaults.agents // []) | if type == "array" then join(",") else . end),
			($skill_filter | if type == "array" then join(",") else . end)
		]
		| join("\u001f")
	'
}

sync_npx_skills_entry() {
	local source="$1" ref="$2" agents_csv="$3" skills_csv="$4"
	local saved_ref="${FLAG_REF}" saved_path="${FLAG_PATH}"
	FLAG_REF="${ref}"
	FLAG_PATH=""

	local skills=()
	if [[ -n ${skills_csv} ]]; then
		IFS=',' read -r -a skills <<<"${skills_csv}"
	fi

	npx_skills_add_for_agents "${source}" "${agents_csv}" "${skills[@]}"

	FLAG_REF="${saved_ref}"
	FLAG_PATH="${saved_path}"
}

sync_legacy_entry() {
	local source="$1" ref="$2" agents_csv="$3" skills_csv="$4"
	local saved_backend="${BACKEND}" saved_ref="${FLAG_REF}" saved_path="${FLAG_PATH}" saved_agent="${TARGET_AGENT}" saved_filters="${LEGACY_SKILL_FILTERS_CSV}"
	BACKEND="legacy"
	FLAG_REF="${ref}"
	FLAG_PATH=""
	LEGACY_SKILL_FILTERS_CSV="${skills_csv}"

	if [[ -n ${agents_csv} ]]; then
		local agents agent
		IFS=',' read -r -a agents <<<"${agents_csv}"
		for agent in "${agents[@]}"; do
			[[ -z ${agent} ]] && continue
			TARGET_AGENT="${agent}"
			cmd_install_source "sync" "${source}"
		done
	else
		TARGET_AGENT=""
		cmd_install_source "sync" "${source}"
	fi

	BACKEND="${saved_backend}"
	FLAG_REF="${saved_ref}"
	FLAG_PATH="${saved_path}"
	TARGET_AGENT="${saved_agent}"
	LEGACY_SKILL_FILTERS_CSV="${saved_filters}"
}

sync_spec_file() {
	local spec_file="$1"
	[[ -f ${spec_file} ]] || die "Spec file not found: ${spec_file}"
	require_cmd yq
	require_cmd jq

	info "Sync spec: ${spec_file}"
	local source ref entry_backend _scope agents_csv skills_csv
	while IFS=$'\x1f' read -r source ref entry_backend _scope agents_csv skills_csv; do
		[[ -z ${source} ]] && continue
		case "${entry_backend}" in
		npx-skills)
			require_cmd npx
			sync_npx_skills_entry "${source}" "${ref}" "${agents_csv}" "${skills_csv}"
			;;
		legacy)
			require_cmd git
			sync_legacy_entry "${source}" "${ref}" "${agents_csv}" "${skills_csv}"
			;;
		*)
			die "Unknown backend in ${spec_file} for ${source}: ${entry_backend}"
			;;
		esac
	done < <(
		# shellcheck disable=SC2312
		spec_rows "${spec_file}"
	)
}

sync_profile() {
	local profile="$1"
	resolve_profile_name "${profile}" >/dev/null
	local spec
	spec="$(profile_spec_path "${profile}")"
	[[ -f ${spec} || -L ${spec} ]] || die "No spec linked for profile: ${profile} (run 'ai-skills profile link ${profile} <spec.yaml>')"

	sync_spec_file "${spec}"

	local fragments_dir
	fragments_dir="$(profile_fragments_dir "${profile}")"
	if [[ -d ${fragments_dir} ]]; then
		local fragment
		for fragment in "${fragments_dir}"/*.yaml; do
			[[ -f ${fragment} ]] || continue
			sync_spec_file "${fragment}"
		done
	fi
}

sync_from_path() {
	local source_path="$1"
	source_path="${source_path/#\~/${HOME}}"
	if [[ -f ${source_path} ]]; then
		sync_spec_file "${source_path}"
	elif [[ -d ${source_path} ]]; then
		local spec
		for spec in "${source_path}"/*.yaml "${source_path}"/profiles/*.yaml; do
			[[ -f ${spec} ]] || continue
			sync_spec_file "${spec}"
		done
	else
		die "Sync source not found: ${source_path}"
	fi
}

# --- Subcommands ---

cmd_bootstrap() {
	while [[ $# -gt 0 ]]; do
		case "$1" in
		--agent)
			TARGET_AGENT="$2"
			shift 2
			;;
		--backend)
			set_backend "$2"
			shift 2
			;;
		--dry-run)
			DRY_RUN=true
			shift
			;;
		-*) die "Unknown option: $1" ;;
		*) die "Unknown argument for bootstrap: $1" ;;
		esac
	done

	echo ""
	echo "$(_bold "ai-skills bootstrap")"
	echo ""

	require_cmd git
	require_cmd jq
	ensure_state_dir

	local core_dir="$REPO_DIR/skills/core"
	if [[ ! -d $core_dir ]]; then
		die "Core skills directory not found: $core_dir"
	fi

	local agents
	if [[ -n $TARGET_AGENT ]]; then
		agents=("$TARGET_AGENT")
	else
		# Merge existing manifest agents with defaults (preserving order, deduplicating).
		# Aliased names (e.g. legacy "pi-mono") are normalized to their canonical keys.
		local existing_agents=()
		mapfile -t existing_agents < <(manifest_get '.agents // [] | .[]' 2>/dev/null || true)
		declare -A seen
		agents=()
		for a in "${existing_agents[@]}" "${DEFAULT_AGENTS[@]}"; do
			[[ -z $a ]] && continue
			a="$(resolve_agent "${a}")"
			[[ -n ${seen[$a]-} ]] && continue
			seen[$a]=1
			agents+=("$a")
		done
	fi

	local agents_json="[]"
	for a in "${agents[@]}"; do
		agents_json="$(echo "$agents_json" | jq --arg a "$a" '. + [$a]')"
	done
	manifest_set ".agents = $agents_json"

	local found_skills=false
	for skill_dir in "$core_dir"/*/; do
		[[ -d $skill_dir ]] || continue
		found_skills=true
		local skill_name
		skill_name="$(basename "$skill_dir")"

		local sid="core/$skill_name"
		if [[ ${BACKEND} == "npx-skills" ]]; then
			require_cmd npx
			npx_skills_add "${skill_dir%/}"
		else
			for agent in "${agents[@]}"; do
				install_skill_to_agent "${skill_dir}" "${agent}" "core/${skill_name}"
			done
			if ! $DRY_RUN; then
				update_manifest_skill "$sid" "local/ai-skills-cli" "skills/core/$skill_name" "local" "${agents[@]}"
			fi
		fi
	done

	if ! $found_skills; then
		warn "No core skills found in $core_dir (add skill directories there first)"
	fi

	echo ""
	info "Bootstrap complete. Agents: ${agents[*]}"
}

cmd_install_source() {
	local command_name="$1"
	shift
	local source=""
	while [[ $# -gt 0 ]]; do
		case "$1" in
		--agent)
			TARGET_AGENT="$2"
			shift 2
			;;
		--ref)
			FLAG_REF="$2"
			shift 2
			;;
		--path)
			FLAG_PATH="$2"
			shift 2
			;;
		--profile)
			FLAG_PROFILE="$2"
			shift 2
			;;
		--backend)
			set_backend "$2"
			shift 2
			;;
		--dry-run)
			DRY_RUN=true
			shift
			;;
		-*) die "Unknown option: $1" ;;
		*)
			source="$1"
			shift
			;;
		esac
	done
	[[ -z $source ]] && die "Usage: ai-skills ${command_name} <source>"

	echo ""
	echo "$(_bold "ai-skills ${command_name}") $source"
	echo ""

	require_cmd git
	require_cmd jq
	ensure_state_dir

	if [[ ${BACKEND} == "npx-skills" ]]; then
		require_cmd npx
		npx_skills_add "${source}"
		echo ""
		info "Delegated install to npx skills (backend=npx-skills)"
		return
	fi

	local repo_dir owner repo ref path source_str source_type install_mode

	if is_local_path "$source"; then
		local resolved
		resolved="$(resolve_local_repo "$source")"
		IFS='|' read -r repo_dir owner repo <<<"$resolved"
		ref="local"
		path="${FLAG_PATH-}"
		source_str="local:$repo_dir"
		source_type="local-worktree"
		install_mode="$(install_mode_for_source_type "${source_type}")"
		debug "Local repo: dir=${repo_dir} owner=${owner} repo=${repo} path=${path} source_type=${source_type} install_mode=${install_mode}"
	else
		local parsed
		parsed="$(parse_github_source "$source")"
		IFS='|' read -r owner repo ref path <<<"$parsed"
		source_type="remote-git"
		install_mode="$(install_mode_for_source_type "${source_type}")"
		debug "Parsed: owner=${owner} repo=${repo} ref=${ref} path=${path} source_type=${source_type} install_mode=${install_mode}"
		repo_dir="$(clone_or_update_repo "$owner" "$repo" "$ref")"
		source_str="github.com/$owner/$repo"
	fi

	if ${DRY_RUN} && [[ ! -d ${repo_dir} ]]; then
		info "[dry-run] Would inspect ${owner}/${repo}${path:+/${path}} after cloning"
		return
	fi

	local agents
	mapfile -t agents < <(target_agents)

	local skill_dirs
	mapfile -t skill_dirs < <(
		for agent in "${agents[@]}"; do
			discover_skills "$repo_dir" "$path" "$agent"
		done | sort -u
	)

	if [[ -n ${LEGACY_SKILL_FILTERS_CSV} && ${LEGACY_SKILL_FILTERS_CSV} != "*" ]]; then
		# shellcheck disable=SC2312
		mapfile -t skill_dirs < <(filter_skill_dirs_by_name "${LEGACY_SKILL_FILTERS_CSV}" "${skill_dirs[@]}")
	fi

	if [[ ${#skill_dirs[@]} -eq 0 ]]; then
		die "No skills found in $owner/$repo${path:+/$path}"
	fi

	for skill_dir in "${skill_dirs[@]}"; do
		[[ -z $skill_dir ]] && continue
		local skill_name
		skill_name="$(basename "$skill_dir")"
		local relative_path="${skill_dir#$repo_dir/}"
		[[ $relative_path == "$skill_dir" ]] && relative_path=""

		local sid
		sid="$(source_id "$owner" "$repo" "$relative_path")"

		for agent in "${agents[@]}"; do
			install_skill_to_agent "$skill_dir" "$agent" "$sid"
		done

		if ! $DRY_RUN; then
			update_manifest_skill "$sid" "$source_str" "$relative_path" "$ref" "${agents[@]}"
		fi
	done

	echo ""
	info "Installed ${#skill_dirs[@]} skill(s) from $owner/$repo"
}

cmd_add() {
	cmd_install_source "add" "$@"
}

cmd_install() {
	cmd_install_source "install" "$@"
}

cmd_update() {
	local target_sid=""
	while [[ $# -gt 0 ]]; do
		case "$1" in
		--agent)
			TARGET_AGENT="$2"
			shift 2
			;;
		--profile)
			FLAG_PROFILE="$2"
			shift 2
			;;
		--backend)
			set_backend "$2"
			shift 2
			;;
		--dry-run)
			DRY_RUN=true
			shift
			;;
		-*) die "Unknown option: $1" ;;
		*)
			target_sid="$1"
			shift
			;;
		esac
	done

	echo ""
	echo "$(_bold "ai-skills update")${target_sid:+ $target_sid}"
	echo ""

	require_cmd git
	require_cmd jq
	ensure_state_dir

	if [[ ${BACKEND} == "npx-skills" ]]; then
		require_cmd npx
		npx_skills_update "${target_sid}"
		echo ""
		info "Delegated update to npx skills (backend=npx-skills)"
		return
	fi

	local sids=()
	if [[ -n $target_sid ]]; then
		local exists
		exists="$(manifest_get ".skills[\"$target_sid\"] // empty")"
		if [[ -n $exists ]]; then
			sids=("${target_sid}")
		else
			local repo_source=""
			repo_source="$(github_repo_selector_source "${target_sid}")"
			if [[ -n ${repo_source} ]]; then
				local matched_sids
				matched_sids="$(manifest_skill_ids_for_repo "${repo_source}")"
				if [[ -n ${matched_sids} ]]; then
					mapfile -t sids <<<"${matched_sids}"
				fi
			fi
			[[ ${#sids[@]} -eq 0 ]] && die "Skill not found in manifest: $target_sid"
		fi
	else
		mapfile -t sids < <(manifest_get '.skills | keys[]' 2>/dev/null)
	fi

	if [[ ${#sids[@]} -eq 0 ]]; then
		warn "No skills in manifest to update"
		return
	fi

	local updated=0
	for sid in "${sids[@]}"; do
		local source ref path profile skill_agents_json
		source="$(manifest_get ".skills[\"$sid\"].source")"
		ref="$(manifest_get ".skills[\"$sid\"].ref")"
		path="$(manifest_get ".skills[\"$sid\"].path")"
		profile="$(manifest_get ".skills[\"${sid}\"].profile // empty")"
		skill_agents_json="$(manifest_get ".skills[\"$sid\"].agents")"

		if [[ $source == "local/ai-skills-cli" ]]; then
			debug "Skipping core skill: $sid (use bootstrap to update)"
			continue
		fi

		echo "  Updating $(_bold "$sid") ..."

		local repo_dir
		local source_type install_mode
		source_type="$(source_type_for_manifest_source "${source}")"
		install_mode="$(install_mode_for_source_type "${source_type}")"
		debug "Manifest source: sid=${sid} source_type=${source_type} install_mode=${install_mode}"

		if [[ ${source_type} == "local-worktree" ]]; then
			repo_dir="${source#local:}"
			if [[ ! -d ${repo_dir} ]]; then
				warn "Local repo missing: ${repo_dir} — skipping ${sid}"
				continue
			fi
		elif [[ ${source_type} == "remote-git" || ${source_type} == "local-cache" ]]; then
			local owner repo
			owner="$(echo "${source}" | sed 's|github.com/||' | cut -d/ -f1)"
			repo="$(echo "${source}" | sed 's|github.com/||' | cut -d/ -f2)"
			if [[ -z ${profile} ]]; then
				profile="$(resolve_profile)"
			else
				profile="$(resolve_profile_name "${profile}")"
			fi
			debug "Using profile ${profile} for ${source}"
			repo_dir="$(clone_or_update_repo "${owner}" "${repo}" "${ref}" "${profile}")"
		else
			warn "Unknown source type for ${sid}: ${source} — skipping"
			continue
		fi

		local agents
		mapfile -t agents < <(echo "$skill_agents_json" | jq -r '.[]')

		for agent in "${agents[@]}"; do
			local skill_dirs
			mapfile -t skill_dirs < <(discover_skills "$repo_dir" "$path" "$agent")
			for skill_dir in "${skill_dirs[@]}"; do
				[[ -z $skill_dir ]] && continue
				install_skill_to_agent "$skill_dir" "$agent" "$sid"
			done
		done

		if ! $DRY_RUN; then
			manifest_set ".skills[\"$sid\"].updated_at = \"$(now_iso)\""
		fi
		updated=$((updated + 1))
	done

	echo ""
	info "Updated $updated skill(s)"
}

cmd_doctor() {
	while [[ $# -gt 0 ]]; do
		case "$1" in
		--backend)
			set_backend "$2"
			shift 2
			;;
		-*) die "Unknown option: $1" ;;
		*) die "Unknown argument for doctor: $1" ;;
		esac
	done

	echo ""
	echo "$(_bold "ai-skills doctor")"
	echo ""

	local issues=0
	local fixes=()

	# --- Prerequisites ---

	for cmd in git jq; do
		if command -v "$cmd" &>/dev/null; then
			info "$cmd: available"
		else
			err "$cmd: not found"
			fixes+=("Install $cmd (e.g. brew install $cmd)")
			issues=$((issues + 1))
		fi
	done

	if command -v gh &>/dev/null; then
		if gh auth status &>/dev/null; then
			info "gh: authenticated"
		else
			warn "gh: not authenticated"
			fixes+=("gh auth login")
			issues=$((issues + 1))
		fi
	else
		warn "gh: not installed (optional, needed for private repos)"
	fi

	if [[ ${BACKEND} == "npx-skills" ]]; then
		if command -v npx &>/dev/null; then
			info "npx: available"
		else
			err "npx: not found (required for backend=npx-skills)"
			fixes+=("Install Node.js/npm so npx is available")
			issues=$((issues + 1))
		fi
	fi

	# --- State ---

	if [[ -d $STATE_DIR ]]; then
		info "State directory: $STATE_DIR"
	else
		warn "State directory missing"
		fixes+=("ai-skills bootstrap")
		issues=$((issues + 1))
	fi

	if [[ -f $MANIFEST ]]; then
		if jq empty "$MANIFEST" 2>/dev/null; then
			info "Manifest: valid JSON"
		else
			err "Manifest: corrupted"
			fixes+=("echo '{\"version\":1,\"agents\":[],\"skills\":{}}' > $MANIFEST")
			issues=$((issues + 1))
		fi
	else
		warn "Manifest: not found"
		fixes+=("ai-skills bootstrap")
		issues=$((issues + 1))
	fi

	# --- Agent directories ---

	local agents
	mapfile -t agents < <(configured_agents)
	for agent in "${agents[@]}"; do
		local dir
		dir="$(agent_dir "$agent")"
		[[ -z $dir ]] && continue

		if [[ ! -d $dir ]]; then
			debug "Agent $agent: directory missing ($dir) — skipping"
			continue
		fi

		local symlinks=0 real_dirs=0 broken=0
		local real_dir_names=() broken_names=()

		for entry in "$dir"/*/; do
			[[ -e $entry || -L ${entry%/} ]] || continue
			local entry_clean="${entry%/}"
			if [[ -L $entry_clean ]]; then
				local link_target
				link_target="$(readlink "$entry_clean")"
				if [[ -e $link_target ]]; then
					symlinks=$((symlinks + 1))
				else
					broken=$((broken + 1))
					broken_names+=("$(basename "$entry_clean")")
				fi
			elif [[ -d $entry_clean ]]; then
				real_dirs=$((real_dirs + 1))
				real_dir_names+=("$(basename "$entry_clean")")
			fi
		done

		local total=$((symlinks + real_dirs + broken))
		info "Agent $agent: $dir ($total skills, $symlinks managed)"

		if [[ $broken -gt 0 ]]; then
			warn "Agent $agent: $broken broken symlink(s): ${broken_names[*]}"
			for name in "${broken_names[@]}"; do
				fixes+=("rm $dir/$name  # broken symlink")
			done
			issues=$((issues + 1))
		fi

		if [[ $real_dirs -gt 0 ]]; then
			warn "Agent $agent: $real_dirs unmanaged skill(s): ${real_dir_names[*]}"
			for name in "${real_dir_names[@]}"; do
				fixes+=("rm -rf $dir/$name  # unmanaged directory, remove if no longer needed")
			done
			issues=$((issues + 1))
		fi
	done

	# --- Manifest vs filesystem ---

	if [[ -f $MANIFEST ]]; then
		local sids
		mapfile -t sids < <(manifest_get '.skills | keys[]' 2>/dev/null || true)
		for sid in "${sids[@]}"; do
			[[ -z $sid ]] && continue
			local skill_agents
			mapfile -t skill_agents < <(manifest_get ".skills[\"$sid\"].agents[]" 2>/dev/null || true)
			local missing_agents=()
			for agent in "${skill_agents[@]}"; do
				[[ -z $agent ]] && continue
				local dir skill_name target
				dir="$(agent_dir "$agent")"
				skill_name="$(basename "$sid")"
				target="$dir/$skill_name"
				if [[ ! -e $target && ! -L $target ]]; then
					missing_agents+=("$agent")
				fi
			done
			if [[ ${#missing_agents[@]} -gt 0 ]]; then
				local source
				source="$(manifest_get ".skills[\"$sid\"].source" 2>/dev/null || echo "unknown")"
				warn "Manifest entry $sid missing from: ${missing_agents[*]}"
				fixes+=("ai-skills add $source  # reinstall to fix missing skill")
				issues=$((issues + 1))
			fi
		done
	fi

	# --- Declarative specs vs manifest ---

	if [[ -f ${MANIFEST} && -d ${PROFILE_SPECS_DIR} ]]; then
		if command -v yq &>/dev/null; then
			declare -A spec_sources=()
			local spec
			for spec in "${PROFILE_SPECS_DIR}"/*.yaml "${PROFILE_FRAGMENTS_DIR}"/*/*.yaml; do
				[[ -f ${spec} || -L ${spec} ]] || continue
				while IFS= read -r source; do
					[[ -z ${source} ]] && continue
					local key
					key="$(source_key "${source}")"
					spec_sources["${key}"]=1
				done < <(yq -o=json '.' "${spec}" | jq -r '.skills[]?.source // empty' 2>/dev/null || true)
			done

			local manifest_sources=()
			# shellcheck disable=SC2310,SC2312
			mapfile -t manifest_sources < <(manifest_get '.skills[]?.source // empty' 2>/dev/null | sort -u || true)
			for source in "${manifest_sources[@]}"; do
				[[ -z ${source} || ${source} == "local/ai-skills-cli" ]] && continue
				local key
				key="$(source_key "${source}")"
				if [[ -z ${spec_sources[${key}]-} ]]; then
					warn "Installed source not represented in profile specs: ${source}"
					fixes+=("Add ${source} to ~/.ai-skills/profiles/<profile>.yaml or remove it if no longer needed")
					issues=$((issues + 1))
				fi
			done
		else
			warn "yq: not installed (skipping declarative spec drift checks)"
		fi
	fi

	if [[ ${BACKEND} == "npx-skills" ]]; then
		if command -v npx &>/dev/null; then
			# shellcheck disable=SC2310
			if npx_skills_check; then
				info "npx skills check: passed"
			else
				warn "npx skills check: reported issues"
				fixes+=("npx skills check")
				issues=$((issues + 1))
			fi
		fi
	fi

	# --- Summary ---

	echo ""
	if [[ $issues -eq 0 ]]; then
		info "All checks passed"
	else
		warn "$issues issue(s) found"
		echo ""
		echo "  $(_bold "How to fix:")"
		echo ""
		for fix in "${fixes[@]}"; do
			echo "    $(_dim "$fix")"
		done
	fi

	echo ""
	return $issues
}

cmd_list() {
	while [[ $# -gt 0 ]]; do
		case "$1" in
		--backend)
			set_backend "$2"
			shift 2
			;;
		--dry-run)
			DRY_RUN=true
			shift
			;;
		-*) die "Unknown option: $1" ;;
		*) die "Unknown argument for list: $1" ;;
		esac
	done

	echo ""
	echo "$(_bold "ai-skills list")"
	echo ""

	ensure_state_dir

	if [[ ${BACKEND} == "npx-skills" ]]; then
		require_cmd npx
		npx_skills_list
		return
	fi

	if [[ ! -f $MANIFEST ]]; then
		warn "No manifest found. Run 'ai-skills bootstrap' first."
		return
	fi

	local sids
	mapfile -t sids < <(manifest_get '.skills | keys[]' 2>/dev/null || true)

	if [[ ${#sids[@]} -eq 0 || (${#sids[@]} -eq 1 && -z ${sids[0]}) ]]; then
		echo "  No skills installed."
		return
	fi

	printf "  %-40s %-12s %-20s %s\n" "SKILL" "REF" "AGENTS" "UPDATED"
	printf "  %-40s %-12s %-20s %s\n" "-----" "---" "------" "-------"

	for sid in "${sids[@]}"; do
		[[ -z $sid ]] && continue
		local ref agents_str updated_at
		ref="$(manifest_get ".skills[\"$sid\"].ref")"
		agents_str="$(manifest_get ".skills[\"$sid\"].agents | join(\",\")")"
		updated_at="$(manifest_get ".skills[\"$sid\"].updated_at")"
		printf "  %-40s %-12s %-20s %s\n" "$sid" "$ref" "$agents_str" "$updated_at"
	done
}

cmd_self_update() {
	echo ""
	echo "$(_bold "ai-skills self-update")"
	echo ""

	if [[ ! -d "$REPO_DIR/.git" ]]; then
		die "Not a git repository: $REPO_DIR (cannot self-update)"
	fi

	local branch
	branch="$(git -C "$REPO_DIR" rev-parse --abbrev-ref HEAD 2>/dev/null || echo "main")"

	info "Pulling latest from $branch..."
	if git -C "$REPO_DIR" pull --ff-only origin "$branch" 2>/dev/null; then
		info "Updated to $(git -C "$REPO_DIR" rev-parse --short HEAD)"
	else
		warn "Could not fast-forward. You may need to resolve manually."
		return 1
	fi

	if [[ -x "$REPO_DIR/scripts/setup" ]]; then
		info "Re-running setup..."
		exec "$REPO_DIR/scripts/setup" --no-doctor
	fi
}

cmd_remove() {
	local sid=""
	while [[ $# -gt 0 ]]; do
		case "$1" in
		--backend)
			set_backend "$2"
			shift 2
			;;
		--dry-run)
			DRY_RUN=true
			shift
			;;
		-*) die "Unknown option: $1" ;;
		*)
			sid="$1"
			shift
			;;
		esac
	done
	[[ -z $sid ]] && die "Usage: ai-skills remove <source-id>"

	echo ""
	echo "$(_bold "ai-skills remove")"
	echo ""

	ensure_state_dir

	if [[ ${BACKEND} == "npx-skills" ]]; then
		require_cmd npx
		npx_skills_remove "${sid}"
		return
	fi

	local entry
	entry="$(jq -r --arg sid "$sid" '.skills[$sid] // empty' "$MANIFEST" 2>/dev/null)"
	[[ -z $entry ]] && die "Skill not found in manifest: $sid"

	local agents
	agents="$(echo "$entry" | jq -r '.agents[]? // empty' 2>/dev/null)"

	for agent in $agents; do
		local dest
		dest="$(agent_dir "$agent")"
		[[ -z $dest ]] && continue

		# Find skill directories that came from this source
		local skill_name
		skill_name="$(basename "$sid")"
		local target="$dest/$skill_name"

		if [[ -d $target ]]; then
			if $DRY_RUN; then
				info "[dry-run] Would remove $target"
			else
				rm -rf "$target"
				info "Removed $(_bold "$skill_name") from $agent"
			fi
		fi
	done

	if ! $DRY_RUN; then
		local tmp
		tmp="$(jq --arg sid "$sid" 'del(.skills[$sid])' "$MANIFEST")"
		echo "$tmp" >"$MANIFEST"
		info "Removed $(_bold "$sid") from manifest"
	fi

	echo ""
}

cmd_self_uninstall() {
	echo ""
	echo "$(_bold "ai-skills self-uninstall")"
	echo ""

	local install_dir="${HOME}/.local/bin"
	local purge=false

	for arg in "$@"; do
		case "$arg" in
		--purge) purge=true ;;
		--install-dir)
			install_dir="$2"
			shift
			;;
		esac
	done

	local target="$install_dir/ai-skills"
	if [[ -L $target || -f $target ]]; then
		rm -f "$target"
		info "Removed: $target"
	else
		warn "Not found: $target"
	fi

	# Remove any alias symlinks pointing to our binary
	for f in "$install_dir"/*; do
		[[ -L $f ]] || continue
		local link_target
		link_target="$(readlink "$f" 2>/dev/null || true)"
		if [[ $link_target == *"/ai-skills-cli/bin/ai-skills" ]]; then
			rm -f "$f"
			info "Removed alias: $f"
		fi
	done

	if $purge; then
		if [[ -d $STATE_DIR ]]; then
			rm -rf "$STATE_DIR"
			info "Removed state directory: $STATE_DIR"
		fi
	else
		warn "State directory preserved: $STATE_DIR (use --purge to remove)"
	fi

	echo ""
	info "CLI uninstalled. Repository clone and agent skill directories were not touched."
	echo ""
}

cmd_profile() {
	local subcmd="${1-}"
	shift || true

	ensure_state_dir

	case "$subcmd" in
	list)
		echo ""
		echo "$(_bold "ai-skills profiles")"
		echo ""
		local default_p
		default_p="$(get_default_profile)"
		local profiles
		profiles="$(config_get '.profiles | keys[]')"
		while IFS= read -r name; do
			local dir
			dir="$(repos_dir_for_profile "$name")"
			local marker=""
			[[ $name == "$default_p" ]] && marker=" $(_green "(default)")"
			echo "  $(_bold "$name")$marker"
			echo "    repos: $(_dim "$dir")"
		done <<<"$profiles"
		echo ""
		;;

	default)
		local name="${1-}"
		[[ -z $name ]] && die "Usage: ai-skills profile default <name>"
		local exists
		exists="$(config_get ".profiles[\"$name\"] // empty")"
		[[ -z $exists ]] && die "Profile not found: $name"
		local cfg
		cfg="$(read_config)"
		cfg="$(echo "$cfg" | jq --arg n "$name" '.default_profile = $n')"
		write_config "$cfg"
		info "Default profile set to $(_bold "$name")"
		;;

	add)
		local name="${1-}"
		[[ -z $name ]] && die "Usage: ai-skills profile add <name> [--repos-dir <path>]"
		shift
		local repos_dir=""
		while [[ $# -gt 0 ]]; do
			case "$1" in
			--repos-dir)
				repos_dir="$2"
				shift 2
				;;
			*) die "Unknown option: $1" ;;
			esac
		done
		local cfg
		cfg="$(read_config)"
		if [[ -n $repos_dir ]]; then
			cfg="$(echo "$cfg" | jq --arg n "$name" --arg d "$repos_dir" '.profiles[$n] = {"repos_dir": $d}')"
		else
			cfg="$(echo "$cfg" | jq --arg n "$name" '.profiles[$n] = {}')"
		fi
		write_config "$cfg"
		local dir
		dir="$(repos_dir_for_profile "$name")"
		info "Profile $(_bold "$name") added (repos: $dir)"
		;;

	remove)
		local name="${1-}"
		[[ -z $name ]] && die "Usage: ai-skills profile remove <name>"
		local default_p
		default_p="$(get_default_profile)"
		[[ $name == "$default_p" ]] && die "Cannot remove the default profile. Change default first."
		local cfg
		cfg="$(read_config)"
		cfg="$(echo "$cfg" | jq --arg n "$name" 'del(.profiles[$n])')"
		write_config "$cfg"
		info "Profile $(_bold "$name") removed"
		;;

	link)
		local name="${1-}" spec="${2-}"
		[[ -z ${name} || -z ${spec} ]] && die "Usage: ai-skills profile link <name> <spec.yaml>"
		resolve_profile_name "${name}" >/dev/null
		local resolved_spec target
		resolved_spec="$(resolve_existing_file "${spec}")"
		target="$(profile_spec_path "${name}")"
		if ${DRY_RUN}; then
			info "[dry-run] Would link ${target} -> ${resolved_spec}"
		else
			mkdir -p "${PROFILE_SPECS_DIR}"
			ln -sfn "${resolved_spec}" "${target}"
			local bold_name
			bold_name="$(_bold "${name}")"
			info "Linked profile ${bold_name} spec: ${target} -> ${resolved_spec}"
		fi
		;;

	unlink)
		local name="${1-}"
		[[ -z ${name} ]] && die "Usage: ai-skills profile unlink <name>"
		resolve_profile_name "${name}" >/dev/null
		local target
		target="$(profile_spec_path "${name}")"
		if [[ ! -e ${target} && ! -L ${target} ]]; then
			warn "No linked spec for profile: ${name}"
			return
		fi
		if ${DRY_RUN}; then
			info "[dry-run] Would remove ${target}"
		else
			rm -f "${target}"
			local bold_name
			bold_name="$(_bold "${name}")"
			info "Unlinked profile ${bold_name} spec"
		fi
		;;

	sources)
		echo ""
		_bold "ai-skills profile sources"
		echo ""
		ensure_state_dir
		mkdir -p "${PROFILE_SPECS_DIR}"
		local default_p profiles
		default_p="$(get_default_profile)"
		profiles="$(config_get '.profiles | keys[]')"
		while IFS= read -r name; do
			[[ -z ${name} ]] && continue
			local target source marker=""
			target="$(profile_spec_path "${name}")"
			if [[ ${name} == "${default_p}" ]]; then
				local green_default
				green_default="$(_green "(default)")"
				marker=" ${green_default}"
			fi
			if [[ -L ${target} ]]; then
				source="$(readlink "${target}")"
			elif [[ -f ${target} ]]; then
				source="${target}"
			else
				source="(not linked)"
			fi
			local bold_name dim_source
			bold_name="$(_bold "${name}")"
			dim_source="$(_dim "${source}")"
			echo "  ${bold_name}${marker}"
			echo "    spec: ${dim_source}"
		done <<<"${profiles}"
		echo ""
		;;

	"" | help)
		cat <<PROF_EOF

$(_bold "ai-skills profile") — manage git credential profiles

$(_bold "SUBCOMMANDS")
  list                         Show all profiles
  default <name>               Set the default profile
  add <name> [--repos-dir]     Add a new profile
  remove <name>                Remove a profile
  link <name> <spec.yaml>      Link a declarative profile spec
  unlink <name>                Remove a linked profile spec
  sources                      Show profile spec links

$(_bold "EXAMPLES")
  ai-skills profile list
  ai-skills profile add work --repos-dir ~/.ai-skills/repos/work
  ai-skills profile default work
  ai-skills profile link personal ~/dotfiles/tools/ai-skills/profiles/personal.yaml
  ai-skills profile sources
  ai-skills add owner/repo --profile work

PROF_EOF
		;;

	*) die "Unknown profile subcommand: $subcmd (run 'ai-skills profile help')" ;;
	esac
}

cmd_sync() {
	local from_path="" all_profiles=false
	while [[ $# -gt 0 ]]; do
		case "$1" in
		--from)
			from_path="$2"
			shift 2
			;;
		--profile)
			FLAG_PROFILE="$2"
			shift 2
			;;
		--all-profiles)
			all_profiles=true
			shift
			;;
		--backend)
			set_backend "$2"
			shift 2
			;;
		--dry-run)
			DRY_RUN=true
			shift
			;;
		-*) die "Unknown option: $1" ;;
		*) die "Unknown argument for sync: $1" ;;
		esac
	done

	echo ""
	_bold "ai-skills sync"
	echo ""

	ensure_state_dir

	if [[ -n ${from_path} ]]; then
		sync_from_path "${from_path}"
	elif ${all_profiles}; then
		mkdir -p "${PROFILE_SPECS_DIR}"
		local spec found=false
		for spec in "${PROFILE_SPECS_DIR}"/*.yaml; do
			[[ -f ${spec} || -L ${spec} ]] || continue
			found=true
			local profile_name
			profile_name="$(basename "${spec}" .yaml)"
			sync_profile "${profile_name}"
		done
		${found} || die "No profile specs found in ${PROFILE_SPECS_DIR}"
	else
		local profile
		profile="$(resolve_profile)"
		sync_profile "${profile}"
	fi

	echo ""
	info "Sync complete"
}

cmd_help() {
	cat <<EOF

$(_bold "ai-skills") v${VERSION} — package manager for AI agent skills

$(_bold "USAGE")
  ai-skills <command> [options]

$(_bold "SKILL COMMANDS")
  add <source>                   Install skill(s) from a GitHub repo or local path
  install <source>               Alias for add
  remove <source-id>             Remove an installed skill from agents and manifest
  update [source-id|owner/repo]  Re-fetch and reinstall skills
  list                           Show installed skills from manifest
  sync                           Apply declarative profile specs

$(_bold "PROFILES")
  profile list        Show configured profiles
  profile default     Set the default profile
  profile add         Add a new profile
  profile remove      Remove a profile
  profile link        Link a profile to a spec file
  profile sources     Show linked profile specs

$(_bold "DIAGNOSTICS")
  doctor              Check health of skills setup

$(_bold "MAINTENANCE")
  self-update         Pull latest CLI and re-run setup
  self-uninstall      Remove CLI symlinks and optionally state directory

$(_bold "OPTIONS")
  --agent <name>      Target a specific agent (agents, cursor, claude, codex, factory, copilot)
  --ref <ref>         Pin to a branch, tag, or commit SHA
  --path <path>       Specify a subpath within the repository
  --profile <name>    Use a specific profile for this command
  --backend <name>    Backend to use: legacy or npx-skills (default: legacy)
  --dry-run           Show what would happen without making changes
  --debug             Enable debug output

$(_bold "SOURCE FORMATS") (for 'add')
  https://github.com/owner/repo
  https://github.com/owner/repo/tree/main/path/to/skill
  owner/repo
  owner/repo/path/to/skill

$(_bold "EXAMPLES")
  ai-skills add gullitmiranda/gullit-skills
  ai-skills install gullitmiranda/gullit-skills
  ai-skills add https://github.com/org/repo/tree/main/skills/my-skill
  ai-skills add owner/repo --path skills/specific --ref v1.0.0
  ai-skills add owner/repo --agent cursor
  ai-skills remove owner/repo/skills/my-skill
  ai-skills update
  ai-skills update owner/repo
  ai-skills update owner/repo/skills/my-skill
  ai-skills profile link personal ~/dotfiles/tools/ai-skills/profiles/personal.yaml
  ai-skills sync --dry-run
  ai-skills doctor

$(_bold "ENVIRONMENT")
  AI_SKILLS_HOME      Override state directory (default: ~/.ai-skills)
  AI_SKILLS_BACKEND   Backend to use: legacy or npx-skills
  AI_SKILLS_NPX_PACKAGE
                      Package spec used by npx-skills backend (default: skills)
  AI_SKILLS_DEBUG     Set to 1 for debug output

EOF
}

# --- Main ---

main() {
	local cmd=""

	while [[ $# -gt 0 ]]; do
		case "$1" in
		--agent)
			TARGET_AGENT="$2"
			shift 2
			;;
		--ref)
			FLAG_REF="$2"
			shift 2
			;;
		--path)
			FLAG_PATH="$2"
			shift 2
			;;
		--profile)
			FLAG_PROFILE="$2"
			shift 2
			;;
		--backend)
			set_backend "$2"
			shift 2
			;;
		--dry-run)
			DRY_RUN=true
			shift
			;;
		--debug)
			export AI_SKILLS_DEBUG=1
			shift
			;;
		--version)
			echo "ai-skills v${VERSION}"
			exit 0
			;;
		--help | -h)
			cmd_help
			exit 0
			;;
		-*) die "Unknown option: $1" ;;
		*)
			if [[ -z $cmd ]]; then
				cmd="$1"
				shift
			else
				break
			fi
			;;
		esac
	done

	[[ -z $cmd ]] && {
		cmd_help
		exit 0
	}

	case "$cmd" in
	bootstrap) cmd_bootstrap "$@" ;;
	add) cmd_add "$@" ;;
	install) cmd_install "$@" ;;
	update) cmd_update "$@" ;;
	remove) cmd_remove "$@" ;;
	list) cmd_list "$@" ;;
	sync) cmd_sync "$@" ;;
	profile) cmd_profile "$@" ;;
	doctor) cmd_doctor "$@" ;;
	self-update) cmd_self_update "$@" ;;
	self-uninstall) cmd_self_uninstall "$@" ;;
	help) cmd_help ;;
	*) die "Unknown command: $cmd (run 'ai-skills help')" ;;
	esac
}

main "$@"
